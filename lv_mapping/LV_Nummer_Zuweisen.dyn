      "HintPath": "C:\\Users\\z0050rrk\\OneDrive - Siemens AG\\Desktop\\LV_Datenbank.csv",
      "InputValue": "C:\\Users\\z0050rrk\\OneDrive - Siemens AG\\Desktop\\LV_Datenbank.csv"
    },
    {
      "ConcreteType": "CoreNodeModels.Input.StringInput, CoreNodeModels",
      "Id": "3a6e277f45f14560921bdc1b1496402f",
      "NodeType": "StringInputNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "a599da2a1ae24887b2d836e0c15c2417",
          "Name": "",
          "Description": "String",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
