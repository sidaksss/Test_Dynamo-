<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nachtrag starten"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="info_text" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="" />

        <TextBlock Text="Nachtragsnummer (nur Ziffern, z. B. 2)" FontWeight="SemiBold" />
        <TextBox x:Name="nummer_feld" Margin="0,4,0,12" Padding="4" />

        <TextBlock Text="Grund (Pflichtfeld, kurz)" FontWeight="SemiBold" />
        <TextBox x:Name="grund_feld" Margin="0,4,0,8" Padding="4" AcceptsReturn="False" />

        <TextBlock x:Name="fehler_text" Foreground="#B00020" TextWrapping="Wrap"
                   Margin="0,0,0,8" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="starten_button" Content="Starten" Width="100" Margin="0,0,8,0"
                    IsDefault="True" Click="starten_klick" />
            <Button Content="Abbrechen" Width="100" IsCancel="True" Click="abbrechen_klick" />
        </StackPanel>
    </StackPanel>
</Window>
